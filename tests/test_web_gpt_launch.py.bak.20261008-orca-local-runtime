    def test_provider_only_sends_terminal_policy_when_opted_in(self) -> None:
        from tools.web_gpt_provider import invoke
        StubBrowserBridge.received_policies.clear()
        server = ThreadingHTTPServer(("127.0.0.1", 0), StubBrowserBridge)
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            env = {
                "ORCA_WEB_AGENT_TOKEN": DEMO_SECRET,
                "ORCA_WEB_AGENT_BRIDGE_URL": "http://127.0.0.1:" + str(server.server_port),
            }
            with patch.dict(os.environ, env):
                self.assertTrue(invoke("planner", "ordinary", 5))
                self.assertTrue(invoke("planner", "read-only no-tools", 5,
                                       terminal_policy="sentinel_dom"))
                self.assertTrue(invoke("planner", "multi read", 5,
                                       terminal_policy="multi_read_probe",
                                       proof_sha256="a" * 64))
            self.assertEqual(
                StubBrowserBridge.received_policies,
                [None, "sentinel_dom", "multi_read_probe"],
            )
        finally:
            server.shutdown()
            server.server_close()
            thread.join(timeout=3)

    def test_provider_and_worker_runner_share_existing_artifact_contract(self) -> None:
        StubBrowserBridge.received_roles.clear()
        server = ThreadingHTTPServer(("127.0.0.1", 0), StubBrowserBridge)
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            with tempfile.TemporaryDirectory() as temp:
                root = Path(temp)
                contract = root / "contract.md"
                contract.write_text("IMPLEMENTER CONTRACT\nProvide JSON.\n", encoding="utf-8")
                output = root / "out" / "implementation.json"
                adapter = TOOLS / "web_gpt_provider.py"
                env = {
                    "ORCA_WEB_AGENT_TOKEN": DEMO_SECRET,
                    "ORCA_WEB_AGENT_BRIDGE_URL":
                        "http://127.0.0.1:" + str(server.server_port),
                    "ORCA_WEB_AGENT_TIMEOUT_SECONDS": "10",
                    "PYTHONDONTWRITEBYTECODE": "1",
                }
                job = {
                    "contract_path": str(contract),
                    "output_path": str(output),
                    "profile_command": [
                        sys.executable, str(adapter), "--role", "implementer",
                        "--add-dir", str(root),
                    ],
                    "agent_cwd": str(root),
                    "timeout_ms": 20_000,
                    "preamble": "task_id=test-web-worker",
                    "task_id": "test-web-worker",
                    "dispatch_id": "test-web-dispatch",
                    "coordinator_handle": "test-coordinator",
                    "worker_handle": "test-worker",
                    "orca_executable": "stub-orca",
                }
                with patch.dict(os.environ, env), patch.object(
                    worker_runner, "_send"
                ) as send:
                    result = worker_runner.run_job(job)
                self.assertEqual(result["status"], "PASS")
                self.assertEqual(
                    json.loads(output.read_text(encoding="utf-8"))["summary"],
                    "Web GPT worker result",
                )
                self.assertTrue(result["artifact_digest"].startswith("sha256:"))
                self.assertEqual(send.call_args.kwargs["message_type"],
                                 "worker_done")
                self.assertEqual(StubBrowserBridge.received_roles,
                                 ["implementer"])
        finally:
            server.shutdown()
            server.server_close()
            thread.join(timeout=3)


